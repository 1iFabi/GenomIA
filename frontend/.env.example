# Copia a .env.local. Variables públicas: Vite las expone al navegador.
# Backend desplegado (en dev, Vite proxya /api al backend local).
# VITE_API_BASE_URL=https://tu-backend.example.com/api

# Client ID del cliente OAuth "Aplicación web" (el mismo valor que GOOGLE_CLIENT_ID del backend).
VITE_GOOGLE_CLIENT_ID=
