# ==========================================
# PLANTILLA DE VARIABLES DE ENTORNO
# ==========================================
# Copia este archivo a .env y llena los valores reales

# ==========================================
# DJANGO CORE
# ==========================================
SECRET_KEY=tu-secret-key-super-segura-generada-aqui
DEBUG=True
ENVIRONMENT=development

# ==========================================
# DATABASE - PostgreSQL Local
# ==========================================
# Opción 1: URL completa (recomendado)
DATABASE_URL=postgresql://usuario:password@localhost:5432/nombre_base_datos

# Opción 2: Variables separadas (alternativa)
# DB_ENGINE=postgresql
# DB_NAME=genomia_db
# DB_USER=postgres
# DB_PASSWORD=tu_password_local
# DB_HOST=localhost
# DB_PORT=5432

# ==========================================
# FRONTEND
# ==========================================
FRONTEND_DOMAIN=http://localhost:5173

# ==========================================
# GMAIL API (Opcional para desarrollo)
# ==========================================
#GMAIL_CREDENTIALS_FILE=C:/ruta/completa/config/credentials.json
#GMAIL_TOKEN_FILE=C:/ruta/completa/config/token.json
DEFAULT_FROM_EMAIL=GenomIA <seqgenomia@gmail.com>

# Comma-separated domains to reject after normalization (exact matches only).
BLOCKED_EMAIL_DOMAINS=
# Exact provider domains allowed for registration. Empty disables the allowlist for custom domains.
ALLOWED_EMAIL_DOMAINS=gmail.com,googlemail.com,outlook.com,hotmail.com,live.com,yahoo.com,icloud.com,me.com,proton.me,protonmail.com,pregrado.uoh.cl,uoh.cl
# DNS fallback resolvers used only when the system resolver returns no MX answer.
EMAIL_VALIDATION_DNS_FALLBACK_NAMESERVERS=1.1.1.1,8.8.8.8
